--
-- Name: usuarios usuarios_select_member; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY usuarios_select_member ON public.usuarios FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.usuario_empresas
  WHERE ((usuario_empresas.usuario_id = usuarios.id) AND public.is_empresa_member(usuario_empresas.empresa_id)))));


--
-- Name: usuarios usuarios_select_own; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY usuarios_select_own ON public.usuarios FOR SELECT USING ((id = auth.uid()));


