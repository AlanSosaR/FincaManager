ALTER TABLE ONLY public.animal_pesajes REPLICA IDENTITY FULL;


ALTER TABLE public.animal_pesajes OWNER TO postgres;

--
-- Name: animal_preñez; Type: TABLE; Schema: public; Owner: postgres
--

