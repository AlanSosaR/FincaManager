--
-- Name: animal_fumigaciones animal_fumigaciones_delete_empresa; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY animal_fumigaciones_delete_empresa ON public.animal_fumigaciones FOR DELETE USING (public.is_empresa_member(empresa_id));


--
-- Name: animal_fumigaciones animal_fumigaciones_insert_empresa; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY animal_fumigaciones_insert_empresa ON public.animal_fumigaciones FOR INSERT WITH CHECK (public.is_empresa_member(empresa_id));


--
-- Name: animal_fumigaciones animal_fumigaciones_select_empresa; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY animal_fumigaciones_select_empresa ON public.animal_fumigaciones FOR SELECT USING (public.is_empresa_member(empresa_id));


--
