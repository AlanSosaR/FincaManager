--
-- Name: empresa_config; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.empresa_config ENABLE ROW LEVEL SECURITY;

--
-- Name: empresa_config empresa_config_insert_admin; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY empresa_config_insert_admin ON public.empresa_config FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.usuario_empresas
  WHERE ((usuario_empresas.empresa_id = empresa_config.empresa_id) AND (usuario_empresas.usuario_id = auth.uid()) AND (usuario_empresas.rol = ANY (ARRAY['propietario'::text, 'admin'::text]))))));


--
-- Name: empresa_config empresa_config_select_member; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY empresa_config_select_member ON public.empresa_config FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.usuario_empresas
  WHERE ((usuario_empresas.empresa_id = empresa_config.empresa_id) AND (usuario_empresas.usuario_id = auth.uid())))));


--
-- Name: empresa_config empresa_config_update_admin; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY empresa_config_update_admin ON public.empresa_config FOR UPDATE USING ((EXISTS ( SELECT 1
   FROM public.usuario_empresas
  WHERE ((usuario_empresas.empresa_id = empresa_config.empresa_id) AND (usuario_empresas.usuario_id = auth.uid()) AND (usuario_empresas.rol = ANY (ARRAY['propietario'::text, 'admin'::text]))))));


